from sprag import Screen, hydrate

from app._shared import shell

from .components import OperationCard
from .modules import OperationDemoModule


class OperationDemoScreen(Screen):
    modules = [OperationDemoModule]

    def render(self, data):
        operation = self.module(OperationDemoModule)
        operation.set_state(data)
        return shell(
            hydrate(OperationCard, module=operation),
        )

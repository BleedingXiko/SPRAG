@dataclass
class Screen:
    """Server-rendered page view.

    Declare ``modules = [MyModule]``. In ``render(data)``, call
    ``self.module(MyModule)``, seed state, then return ``hydrate(...)`` or
    ``ui.*`` markup.
    """

    data: dict[str, Any] = ...
    modules: list[type[Module]] = ...

    def module(self, module_type: Type[M]) -> M: ...
    def render(self, data: dict[str, Any]) -> Any: ...
    @classmethod
    def sample_data(cls) -> dict[str, Any]: ...


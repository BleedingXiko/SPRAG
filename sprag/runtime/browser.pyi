"""Type stubs for sprag.runtime.browser.

These describe the **browser-side** authoring surface. The runtime methods
all raise ``RuntimeError`` in plain Python — they only do real work in the
emitted JS. Stubs here exist so that IDE autocomplete and type-checkers
can read the surface every SPRAG user actually writes against.
"""

from dataclasses import dataclass
from typing import Any, Callable, Iterable, List, Optional, Type, TypeVar

F = TypeVar("F", bound=Callable[..., Any])
C = TypeVar("C", bound=type)
M = TypeVar("M", bound="Module")

EventHandler = Callable[..., Any]
"""DOM / bus / socket event callback."""

Cleanup = Callable[[], Any]
"""Cleanup function registered via ``add_cleanup``."""

Unsubscribe = Callable[[], Any]
"""Returned by subscriptions (``listen``, ``watch_state``, ``subscribe``)."""

TimerHandle = Any
"""Opaque handle returned by ``timeout`` / ``interval``."""


class BrowserElement:
    """Mounted DOM element handle used by browser-authored Python."""

    def query_selector(self, selector: str) -> Any: ...
    def query_selector_all(self, selector: str) -> Iterable[Any]: ...
    def querySelector(self, selector: str) -> Any: ...
    def querySelectorAll(self, selector: str) -> Iterable[Any]: ...
    def set_attribute(self, name: str, value: Any) -> None: ...
    def get_attribute(self, name: str) -> Any: ...
    def remove_attribute(self, name: str) -> None: ...
    def add_event_listener(self, event: str, fn: EventHandler) -> None: ...
    def remove_event_listener(self, event: str, fn: EventHandler) -> None: ...
    def __getattr__(self, name: str) -> Any: ...


class VirtualScrollerHandle:
    """Public handle exposed as ``self.virtual_scroll`` on decorated components."""

    def reset(self) -> None: ...
    def mount(self, element: Any) -> None: ...
    def unmount(self) -> None: ...
    def recycle(self) -> None: ...
    def rebind(self, options: Optional[dict] = ..., container: Optional[Any] = ...) -> None: ...
    def debug_state(self) -> dict[str, Any]: ...
    def acquire_child(self, chunk_index: int, child: Any, mount: Any) -> Any: ...
    def __getattr__(self, name: str) -> Any: ...


# ---------------------------------------------------------------------------
# Module — browser-side lifecycle owner
# ---------------------------------------------------------------------------

@dataclass
class Module:
    """Browser-side logic for DOM events, state, actions, sockets, and timers.

    Put setup in ``on_start()``. Common calls: ``self.delegate(...)``,
    ``self.set_state(...)``, ``self.call_action(...)``, ``self.on_socket(...)``.
    In ``Screen.render()``, call ``self.module(MyModule)``, seed state, then
    return ``hydrate(Component, module=module)``.
    """

    screen: Optional["Screen"] = ...
    state: dict[str, Any] = ...
    stores: list[Any] = ...
    element: BrowserElement = ...
    component: "Component" = ...

    def on_start(self) -> None: ...
    def on_stop(self) -> None: ...

    # DOM events
    def on(self, target: Any, event: str, fn: EventHandler) -> None: ...
    def off(self, target: Any, event: str, fn: EventHandler) -> None: ...
    def delegate(
        self, target: Any, event: str, selector: str, fn: EventHandler
    ) -> None: ...

    # Bus
    def listen(self, event: str, fn: EventHandler) -> Unsubscribe: ...
    def emit(self, event: str, data: Any = ...) -> None: ...

    # Managed timers
    def timeout(self, fn: Callable[[], Any], seconds: float) -> TimerHandle: ...
    def interval(self, fn: Callable[[], Any], seconds: float) -> TimerHandle: ...
    def clear_timeout(self, handle: TimerHandle) -> None: ...
    def clear_interval(self, handle: TimerHandle) -> None: ...

    # Lifecycle ownership
    def add_cleanup(self, fn: Cleanup) -> None: ...
    def adopt(self, child: Any) -> Any: ...
    def adopt_component(self, component: "Component") -> "Component": ...

    # State
    def set_state(self, new_state: dict[str, Any]) -> dict[str, Any]: ...
    def batch_state(self, fn: Callable[[], Any]) -> None: ...
    def watch_state(self, fn: Callable[..., Any]) -> Unsubscribe: ...
    def subscribe(self, store: Any, fn: Callable[..., Any]) -> Unsubscribe: ...
    def create_selector(
        self,
        deps: List[Callable[..., Any]],
        fn: Callable[..., Any],
    ) -> Callable[..., Any]: ...
    def provider(self, name: str) -> Any: ...

    # Server push
    def on_socket(self, event: str, fn: EventHandler) -> Unsubscribe: ...
    def off_socket(self, event: str, fn: EventHandler) -> None: ...
    def emit_socket(self, event: str, payload: Any = ...) -> None: ...
    def refetch_on_socket(
        self,
        event: str = ...,
        action: Optional[str] = ...,
        on_result: Optional[Callable[..., Any]] = ...,
        on_error: Optional[Callable[..., Any]] = ...,
    ) -> Unsubscribe: ...
    def join_topic(self, topic: str) -> None: ...
    def leave_topic(self, topic: str) -> None: ...

    # Actions
    def call_action(self, name: str, payload: Optional[dict[str, Any]] = ...) -> Any: ...
    def action_error_message(
        self, error: Any, fallback: Optional[str] = ...
    ) -> str: ...
    def form_data(self, source: Any) -> dict[str, Any]: ...
    def upload_form(
        self,
        name: str,
        source: Any,
        on_progress: Optional[Callable[..., Any]] = ...,
    ) -> Any: ...
    def upload(
        self,
        name: str,
        file: Any,
        payload: Optional[dict[str, Any]] = ...,
        on_progress: Optional[Callable[..., Any]] = ...,
    ) -> Any: ...
    def navigate(self, target: str, options: Optional[dict[str, Any]] = ...) -> None: ...
    def set_metadata(self, metadata: dict[str, Any], options: Optional[dict[str, Any]] = ...) -> None: ...

# ---------------------------------------------------------------------------
# Component — browser-side DOM owner
# ---------------------------------------------------------------------------

@dataclass
class Component:
    """Browser-side DOM renderer.

    Implement ``render(props=None)`` to return a ``ui.*`` tree. Use
    ``self.props``, ``self.state``, ``self.refs``, and ``self.set_state(...)``
    for local rendering behavior.
    """

    props: dict[str, Any] = ...
    state: dict[str, Any] = ...
    refs: dict[str, Any] = ...
    element: BrowserElement = ...
    virtual_scroll: VirtualScrollerHandle = ...

    # Required override
    def render(self, props: Optional[dict[str, Any]] = ...) -> Any: ...

    # Lifecycle overrides
    def on_start(self) -> None: ...
    def on_stop(self) -> None: ...

    def on_start(self) -> None: ...
    def on_stop(self) -> None: ...

    # Operational mount/unmount
    def mount(self, parent: Any) -> None: ...
    def mount_before(self, sibling: Any) -> None: ...
    def unmount(self) -> None: ...

    # State
    def set_state(self, new_state: dict[str, Any]) -> dict[str, Any]: ...
    def set_state_sync(self, new_state: dict[str, Any]) -> dict[str, Any]: ...

    # DOM events
    def on(self, target: Any, event: str, fn: EventHandler) -> None: ...
    def off(self, target: Any, event: str, fn: EventHandler) -> None: ...
    def delegate(
        self, target: Any, event: str, selector: str, fn: EventHandler
    ) -> None: ...

    # Bus
    def listen(self, event: str, fn: EventHandler) -> Unsubscribe: ...
    def emit(self, event: str, data: Any = ...) -> None: ...

    # Timers
    def timeout(self, fn: Callable[[], Any], seconds: float) -> TimerHandle: ...
    def interval(self, fn: Callable[[], Any], seconds: float) -> TimerHandle: ...

    # Lifecycle ownership
    def add_cleanup(self, fn: Cleanup) -> None: ...
    def adopt(self, child: Any) -> Any: ...
    def create_selector(
        self,
        deps: List[Callable[..., Any]],
        fn: Callable[..., Any],
    ) -> Callable[..., Any]: ...

    # Forms / uploads
    def form_data(self, source: Any) -> dict[str, Any]: ...
    def upload_form(
        self,
        name: str,
        source: Any,
        on_progress: Optional[Callable[..., Any]] = ...,
    ) -> Any: ...
    def upload(
        self,
        name: str,
        file: Any,
        payload: Optional[dict[str, Any]] = ...,
        on_progress: Optional[Callable[..., Any]] = ...,
    ) -> Any: ...
    def action_error_message(
        self, error: Any, fallback: Optional[str] = ...
    ) -> str: ...
    def navigate(self, target: str, options: Optional[dict[str, Any]] = ...) -> None: ...
    def set_metadata(self, metadata: dict[str, Any], options: Optional[dict[str, Any]] = ...) -> None: ...


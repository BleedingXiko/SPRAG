from functools import lru_cache
from pathlib import Path

from sprag import join_url, load_markdown_tree


CONTENT_ROOT = Path(__file__).resolve().parent / "content"


def _collection_key(name):
    parts = [part.strip("/") for part in str(name).split("/") if part and str(part).strip("/")]
    if not parts:
        raise ValueError("content collection name must not be empty")
    return "/".join(parts)


@lru_cache(maxsize=64)
def content_collection(name, *, base_url=None, reverse=False):
    key = _collection_key(name)
    docs = load_markdown_tree(CONTENT_ROOT / key, base_url=base_url or join_url("/", key))
    return list(reversed(docs)) if reverse else docs


def content_static_paths(name, *, base_url=None, reverse=False):
    return [
        {"segments": list(doc.path_parts)}
        for doc in content_collection(name, base_url=base_url, reverse=reverse)
    ]


def slim_content_doc(doc):
    """Strip server-only fields before sending a doc to the browser payload."""
    return {
        "title": doc.title,
        "description": doc.description,
        "excerpt": doc.excerpt,
        "html": doc.html,
        "url_path": doc.url_path,
        "slug": doc.slug,
        "path_parts": list(doc.path_parts),
        "metadata": doc.metadata,
    }


def find_content_doc(name, segments, *, base_url=None, reverse=False):
    wanted = tuple(part for part in (segments or []) if part)
    for doc in content_collection(name, base_url=base_url, reverse=reverse):
        if doc.path_parts == wanted:
            return doc
    return None

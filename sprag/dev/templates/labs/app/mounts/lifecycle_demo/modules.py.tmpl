from sprag import Module, dom

from .web import (
    LifecycleActivityView,
    LifecycleOverviewView,
    LifecycleSettingsView,
)


class LifecycleDemoModule(Module):
    def __init__(self, screen=None, state=None):
        super().__init__(screen=screen, state=state or {})
        self._active_view = None
        self._active_view_name = None
        self._switches = 0

    def on_start(self):
        self._switches = self.state.get("switches", 0)
        self.delegate(self.element, "click", "[data-view]", self.on_view)
        self.show_view(self.state.get("view", "overview"))

    def on_stop(self):
        owner_status = self.component.element.query_selector("[data-sprag-owner-status]")
        if owner_status:
            owner_status.text_content = "stopping"
        self.teardown_view()

    def on_view(self, event, target):
        event.prevent_default()
        self.show_view(target.dataset.view)

    def show_view(self, view):
        if view == self._active_view_name:
            return None

        slot = self.component.element.query_selector("[data-sprag-view-slot]")
        if not slot:
            return None

        self.teardown_view()

        if self._active_view_name is not None:
            self._switches += 1

        previous = self._active_view_name or "none"
        next_view = view
        if next_view == "activity":
            self._active_view = LifecycleActivityView({"switches": self._switches})
        elif next_view == "settings":
            self._active_view = LifecycleSettingsView({"switches": self._switches})
        else:
            next_view = "overview"
            self._active_view = LifecycleOverviewView({"switches": self._switches})

        self._active_view_name = next_view
        self._active_view.mount(slot)
        self.update_shell(next_view, previous)

    def teardown_view(self):
        if self._active_view:
            self._active_view.unmount()
            self._active_view = None

        if self.component and self.component.element:
            slot = self.component.element.query_selector("[data-sprag-view-slot]")
            if slot:
                dom.clear(slot)

    def update_shell(self, view, previous):
        for button in self.component.element.query_selector_all("[data-view]"):
            is_active = button.dataset.view == view
            button.class_list.toggle("is-active", is_active)
            button.set_attribute("aria-selected", is_active)

        status = self.component.element.query_selector("[data-sprag-view-status]")
        if status:
            status.text_content = view

        count = self.component.element.query_selector("[data-sprag-switch-count]")
        if count:
            count.text_content = str(self._switches)

        log = self.component.element.query_selector("[data-sprag-lifecycle-log]")
        if log:
            log.text_content = (
                "unmount " + previous + "\n"
                + "mount " + view + "\n"
                + "root Module still running"
            )

from sprag import Module


class QueueDemoModule(Module):
    def __init__(self, screen=None, state=None):
        super().__init__(
            screen=screen,
            state=state or {
                "job": None,
                "queue": {"pending": 0, "active": 0, "active_jobs": [], "workers": 1},
                "message": "Queue a short background job.",
            },
        )

    def on_start(self):
        self.delegate(self.element, "click", "[data-role='enqueue']", self.on_enqueue)
        self.delegate(self.element, "click", "[data-role='cancel']", self.on_cancel)
        self.on_socket("sprag:queue.job.changed", self.on_job_signal)

    def on_enqueue(self, event):
        event.prevent_default()
        queue = self.state.get("queue") or {}
        label = "Job " + str((queue.get("pending", 0) + queue.get("active", 0)) + 1)
        self.set_state({"message": "Queueing " + label + "..."})
        self.call_action("start", {"label": label}).then(self.on_job_result)

    def on_cancel(self, event):
        event.prevent_default()
        job = self.state.get("job") or {}
        job_id = job.get("id")
        if not job_id:
            return
        self.set_state({"message": "Requesting cancellation..."})
        self.call_action("cancel", {"job_id": job_id}).then(self.on_job_result)

    def on_job_result(self, result):
        self.apply_snapshot(result.value)

    def on_job_signal(self, payload):
        job = self.state.get("job") or {}
        job_id = payload.get("job_id") or job.get("id")
        if not job_id:
            return
        self.call_action("status", {"job_id": job_id}).then(self.on_job_result)

    def apply_snapshot(self, snapshot):
        self.set_state(
            {
                "job": snapshot.get("job"),
                "queue": snapshot.get("queue", self.state.get("queue", {})),
                "message": snapshot.get("message", self.state.get("message")),
            }
        )

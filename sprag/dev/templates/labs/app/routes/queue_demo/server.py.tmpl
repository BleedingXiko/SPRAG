from sprag import Controller, Field, Schema, action


class QueueDemoController(Controller):
    route = "/queue-demo"

    def load(self):
        queue = self.queue("job_queue")
        job = queue.latest_job(session_id=self.request.session_id)
        if job is None:
            return {
                "accepted": True,
                "job": None,
                "queue": queue.queue_snapshot(),
                "message": "Queue a short background job.",
            }
        return queue.job_action_result(job_id=job["id"], accepted=True)

    @action(name="start", schema=Schema("start", {"label": Field(str, required=True)}))
    def queue_start(self, label):
        return self.enqueue("job_queue", {"label": label}, label=label)

    @action(schema=Schema("status", {"job_id": Field(str, required=True)}))
    def status(self, job_id):
        return self.job_status("job_queue", job_id)

    @action(schema=Schema("cancel", {"job_id": Field(str, required=True)}))
    def cancel(self, job_id):
        return self.request_job_cancel("job_queue", job_id)

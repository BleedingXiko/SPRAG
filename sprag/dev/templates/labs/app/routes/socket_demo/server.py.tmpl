from sprag import Controller, Schema, action, socket_target


class SocketDemoController(Controller):
    route = "/socket-demo"

    def load(self):
        return {
            "connected": False,
            "status": "Open the socket bridge and send a ping.",
            "message_count": 0,
            "last_message": "No socket activity yet.",
        }

    def build_events(self, handler):
        handler.on("lab:socket.ping", self.handle_ping)

    def handle_ping(self, payload=None):
        payload = payload or {}
        count = payload.get("count", 0)
        self.emit_socket(
            "lab:socket.pong",
            {
                "message": f"Controller received ping #{count} from browser socket ingress.",
                "count": count,
            },
            route=self.route,
        )

    @action(schema=Schema("snapshot", {}))
    def snapshot(self):
        return {
            "message": "Controller returned authoritative state through an action refetch.",
            "session_id": self.request.session_id,
        }

    @action(schema=Schema("broadcast", {}))
    def broadcast(self):
        delivered = self.emit_socket_refetch(
            "snapshot",
            target=socket_target(
                route=self.route,
                session_id=self.request.session_id,
            ),
        )
        return {
            "message": (
                "Session-targeted socket refetch signal sent."
                if delivered
                else "No live websocket client connected yet."
            ),
            "delivered": delivered,
        }

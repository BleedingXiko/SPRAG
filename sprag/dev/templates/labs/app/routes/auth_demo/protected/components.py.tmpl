from sprag import Component, ui


class ProtectedAuthCard(Component):
    def render(self, props=None):
        profiles = self.state.get("available_profiles") or []
        return ui.div(
            ui.h2(self.state.get("title", "Protected Route")),
            ui.p(self.state.get("message", "")),
            ui.div(
                ui.span("Viewer"),
                ui.strong(self.state.get("viewer_name", "unknown")),
                class_="metric",
            ),
            ui.div(
                ui.span("Active Profile"),
                ui.strong(self.state.get("active_profile_name", "No active profile")),
                class_="metric",
            ),
            ui.div(
                ui.span("Status"),
                ui.strong(self.state.get("status", "ready")),
                class_="metric",
            ),
            ui.div(
                ui.button(
                    "Refetch Identity",
                    type="button",
                    class_="btn btn-inline",
                    data_role="whoami",
                ),
                ui.button(
                    "Publish Restricted Report",
                    type="button",
                    class_="btn btn-inline",
                    data_role="publish-report",
                ),
                ui.button(
                    "Logout",
                    type="button",
                    class_="btn btn-ghost btn-inline",
                    data_role="logout",
                ),
                class_="form-actions",
            ),
            ui.div(
                [
                    ui.button(
                        f"Switch to {profile.get('label', profile.get('slug', 'profile'))}",
                        type="button",
                        class_="btn btn-inline",
                        data_role="switch-profile",
                        data_profile=profile.get("slug"),
                    )
                    for profile in profiles
                ],
                class_="form-actions",
            ),
            ui.div(
                ui.h3("SSR `__sprag_auth__`"),
                ui.div(
                    self.state.get("auth_snapshot_text", "{}"),
                    class_="form-snapshot",
                    style="white-space: pre-wrap; font-family: monospace;",
                ),
            ),
            ui.div(
                ui.h3("window.__SPRAG_PAYLOAD__.auth"),
                ui.div(
                    self.state.get("client_auth_text", "{}"),
                    class_="form-snapshot",
                    style="white-space: pre-wrap; font-family: monospace;",
                ),
            ),
            class_="demo-card form-demo-card",
        )

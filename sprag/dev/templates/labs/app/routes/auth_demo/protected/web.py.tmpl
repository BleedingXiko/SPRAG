import json

from sprag import Screen, hydrate

from .components import ProtectedAuthCard
from .modules import ProtectedAuthModule


class ProtectedAuthScreen(Screen):
    modules = [ProtectedAuthModule]

    def render(self, data):
        protected_auth = self.module(ProtectedAuthModule)
        snapshot = dict(data or {})
        snapshot["auth_snapshot_text"] = json.dumps(
            snapshot.get("__sprag_auth__") or {},
            indent=2,
            sort_keys=True,
        )
        snapshot.setdefault("client_auth_text", "{}")
        protected_auth.set_state(snapshot)
        return hydrate(ProtectedAuthCard, module=protected_auth)

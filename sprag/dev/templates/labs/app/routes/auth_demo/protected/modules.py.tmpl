from sprag import Module, browser


class ProtectedAuthModule(Module):
    def __init__(self, screen=None, state=None):
        super().__init__(
            screen=screen,
            state=state
            or {
                "title": "Protected Route",
                "message": "",
                "viewer_name": "",
                "active_profile_name": "",
                "available_profiles": [],
                "__sprag_auth__": {},
                "client_auth": None,
                "auth_snapshot_text": "{}",
                "client_auth_text": "{}",
                "status": "ready",
            },
        )

    def on_start(self):
        self.delegate(self.element, "click", "[data-role='logout']", self.on_logout)
        self.delegate(self.element, "click", "[data-role='whoami']", self.on_whoami)
        self.delegate(
            self.element,
            "click",
            "[data-role='publish-report']",
            self.on_publish_report,
        )
        self.delegate(
            self.element,
            "click",
            "[data-role='switch-profile']",
            self.on_switch_profile,
        )
        payload = browser.window.__SPRAG_PAYLOAD__ or {}
        client_auth = payload.get("auth") or None
        self.set_state(
            {
                "client_auth": client_auth,
                "client_auth_text": browser.window.JSON.stringify(client_auth or {}, None, 2),
            }
        )

    def on_logout(self, event):
        event.prevent_default()
        self.set_state({"status": "Signing out..."})
        self.call_action("logout", {}).catch(self.on_error)

    def on_whoami(self, event):
        event.prevent_default()
        self.call_action("whoami", {"label": "client refresh"}).then(self.on_whoami_result).catch(
            self.on_error
        )

    def on_publish_report(self, event):
        event.prevent_default()
        self.set_state({"status": "Checking profile permissions..."})
        self.call_action("publish-report", {}).then(self.on_publish_result).catch(self.on_error)

    def on_switch_profile(self, event):
        event.prevent_default()
        profile = event.target.dataset.profile
        self.set_state({"status": f"Switching to {profile}..."})
        self.call_action("switch-profile", {"profile": profile}).then(
            self.on_switch_profile_result
        ).catch(self.on_error)

    def on_whoami_result(self, result):
        data = result.value or {}
        self.set_state(
            {
                "status": data.get("label", "refreshed"),
                "viewer_name": data.get("viewer_name", self.state.get("viewer_name")),
                "active_profile_name": data.get(
                    "active_profile_name",
                    self.state.get("active_profile_name"),
                ),
            }
        )

    def on_publish_result(self, result):
        data = result.value or {}
        self.set_state({"status": data.get("status", "Published.")})

    def on_switch_profile_result(self, result):
        data = result.value or {}
        self.set_state(
            {
                "status": data.get("status", "Profile updated."),
                "active_profile_name": data.get(
                    "active_profile_name",
                    self.state.get("active_profile_name"),
                ),
            }
        )

    def on_error(self, error):
        response = error.response
        self.set_state({"status": response["error"] if response else error.message})

from sprag import Controller, Schema, action

from app.stores import lab_tally


class StoreDemoController(Controller):
    route = "/store-demo"

    def load(self):
        # Read the cross-runtime store from the server side.
        return {"count": lab_tally.get("count")}

    @action(schema=Schema("bump", {}))
    def bump(self):
        # Mutate the shared store on the server. A real app could also
        # read this from a /counter route, a Service, or a QueueService
        # handler — same Python object, same surface.
        lab_tally.set("count", lab_tally.get("count") + 1)
        return {"count": lab_tally.get("count")}

    @action(schema=Schema("reset", {}))
    def reset(self):
        lab_tally.patch({"count": 0})
        return {"count": 0}
